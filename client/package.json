{
  "name": "hamster-client",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke:locale": "node ../scripts/ui-smoke-locale.mjs",
    "start:prod": "node server.mjs",
    "test:pwa": "node --experimental-strip-types --test src/lib/pwaUpdate.test.mjs",
    "test:pwa-lifecycle": "node scripts/pwa-update-lifecycle.mjs",
    "test:entrypoint-parity": "node scripts/entrypoint-parity-node.mjs",
    "test:server-safejoin": "node --test server.safejoin.test.mjs",
    "test:harness-guards": "node --test scripts/harness-guards.test.mjs"
  },
  "dependencies": {
    "@openuidev/react-lang": "^1.1.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.6"
  },
  "description": "Hamster P0 React web client"
}
