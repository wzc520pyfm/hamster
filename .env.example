# Copy to .env for local Compose overrides. None of these defaults are real secrets.
# Every value below is overridable; do not commit a filled .env.

HAMSTER_DB_PASSWORD=changeme
HAMSTER_SECRET_KEY=super-secret-change-me
HAMSTER_INTERNAL_SECRET=dev-internal-secret
HAMSTER_AGENT_USERNAME=hamster
HAMSTER_AGENT_PASSWORD=dev-agent-password
HAMSTER_APPROVAL_TTL_SECONDS=600
HAMSTER_CORS_ORIGIN=http://localhost:3000
HAMSTER_STEP_DELAY_MS=2000

# Optional: leave empty to keep eve's scripted fixture model (no invented results).
# Set a real provider model id only when credentials are available in the environment.
HAMSTER_MODEL_ID=

# Client build-time API origin (browser calls this host).
VITE_API_BASE_URL=http://localhost:8080
