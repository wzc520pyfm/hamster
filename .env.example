# Copy to .env for local Compose overrides. None of these defaults are real secrets.
# Every value below is overridable; do not commit a filled .env.
# `.env` is gitignored; never commit real secrets.

HAMSTER_DB_PASSWORD=changeme
HAMSTER_SECRET_KEY=super-secret-change-me
HAMSTER_INTERNAL_SECRET=dev-internal-secret
HAMSTER_AGENT_USERNAME=hamster
HAMSTER_AGENT_PASSWORD=dev-agent-password
HAMSTER_APPROVAL_TTL_SECONDS=600
HAMSTER_CORS_ORIGIN=http://localhost:3000
HAMSTER_STEP_DELAY_MS=2000

# Optional: leave empty to keep eve's scripted fixture model (no invented results).
# Set a real provider model id ONLY when credentials are available in the environment.
# HAMSTER_MODEL_ID is a NATIVE provider model id (no provider prefix), e.g. "claude-sonnet-5".
# Provider-qualified strings like "anthropic/claude-…" are not used on the direct path.
HAMSTER_MODEL_ID=

# Provider for HAMSTER_MODEL_ID: "anthropic", "openai", or "deepseek".
# Optional: when unset, the agent picks the provider from the first matching key below.
HAMSTER_MODEL_PROVIDER=

# Direct vendor provider keys (passed only to the agent service by docker-compose.yml).
# Empty by default; never commit real values. Secrets live in the gitignored .env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional DeepSeek live model (provider "deepseek"):
#   HAMSTER_MODEL_ID=deepseek-flash
#   HAMSTER_MODEL_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=<placeholder>
# Default recommended native model id: deepseek-flash (DeepSeek-V4.1-Flash-1017).
# Retired ids deepseek-chat / deepseek-reasoner must not be used.
# Official OpenAI-compatible base URL: https://api.deepseek.com
# DeepSeek keys must NEVER be written into OPENAI_API_KEY or ANTHROPIC_API_KEY.

# Client production API base must stay EMPTY so the SPA uses same-origin /api
# (client/server.mjs reverse-proxies to API_UPSTREAM). Do NOT set localhost:8080 —
# that bakes a phone loopback into the production bundle. Compose forces an empty bake.
VITE_API_BASE_URL=
